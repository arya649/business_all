# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server only: creating users from Super Admin
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Zentrix ADK (AI): base URL, this product's partner id, key id and signing key
ZENTRIX_URL=https://ai.example.com
ZENTRIX_PARTNER_ID=group-erp
ZENTRIX_KID=group-erp-2026-10
ZENTRIX_SIGNING_KEY=<zadk new-secret>
